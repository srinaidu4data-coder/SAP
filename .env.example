# OpenAI (primary when set — used by Co-pilot planner / diagnosis)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SAPILOT_PLANNER_MODEL=gpt-4o
SAPILOT_CRITIC_MODEL=gpt-4o
SAPILOT_DIAGNOSIS_MODEL=gpt-4o
SAPILOT_SCREEN_MODEL=gpt-4o-mini

# SpaceXAI / xAI (optional alternative — used for grok-* models)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Optional second-vendor critic (Anthropic)
ANTHROPIC_API_KEY=

# SAP connection defaults (never put passwords here — use `sapilot vault set`)
SAPILOT_ASHOST=
SAPILOT_SYSNR=00
SAPILOT_CLIENT=100
SAPILOT_USER=
SAPILOT_LANG=EN

# Execution
SAPILOT_CHANNEL=hybrid
SAPILOT_ALLOW_VISION=0
SAPILOT_POLICY_PATH=sapilot/policy/local_policy.yaml
